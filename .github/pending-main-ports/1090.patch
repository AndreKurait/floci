diff --git a/src/test/java/io/github/hectorvent/floci/services/ec2/SecurityGroupFirewallInspectionBatchTest.java b/src/test/java/io/github/hectorvent/floci/services/ec2/SecurityGroupFirewallInspectionBatchTest.java
